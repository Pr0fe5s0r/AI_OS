# -------------------------------------------------------------------
# Copy this file to `.env` and fill in ONE embedding provider's key.
# Whatever you provide here is what the system uses for embeddings.
# -------------------------------------------------------------------

# Which adapter to use: openai | nebius | openrouter
LLM_PROVIDER=openai

# Embedding model (must output 1536 dims to match the schema).
EMBEDDING_MODEL=text-embedding-3-small

# Chat model (detection runtime, Checkpoint 3).
CHAT_MODEL=gpt-4o-mini

# Secrets sealing key. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# -------------------------------------------------------------------
# Neo4j — the living graph + vector store. The compose file wires the
# containers together; these creds are also used by the healthcheck.
# -------------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=markos-graph

# --- Option A: OpenAI (or ANY OpenAI-compatible endpoint) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# --- Option B: Nebius Token Factory / AI Studio ---
# LLM_PROVIDER=nebius
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_API_KEY=

# --- Option C: OpenRouter ---
# LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# -------------------------------------------------------------------
# Real GitHub connector. Two ways to connect, pick either:
#
# A) "Sign in with GitHub" (OAuth — recommended; no token to copy around).
#    Register an OAuth app at https://github.com/settings/developers:
#      Application name:          MarkOS (anything)
#      Homepage URL:              http://localhost:3000
#      Authorization callback URL: http://localhost:8000/api/oauth/github/callback
#    ...then paste the Client ID + a generated Client Secret below. The
#    secret is used ONLY server-side, in the back-channel code exchange.
#
#    Scope defaults to `public_repo` (least privilege: read issues/PRs, write
#    labels/assignees/comments on PUBLIC repos — everything the shipped moves
#    need). Set `repo` ONLY if you must watch private repos: it grants
#    read/write to every repository the signing-in user can see.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=public_repo

# "Sign in with Slack" (OAuth). From api.slack.com/apps -> your app -> Basic
# Information -> App Credentials. Redirect URL to register on Slack's side:
#   <PUBLIC_BASE_URL>/api/oauth/slack/callback   (Slack requires HTTPS)
# Bot Token Scopes: channels:history, channels:read, users:read.
# Unset -> the UI falls back to pasting a bot token (xoxb-…), which needs no
# client id and works on plain localhost.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_SCOPE=channels:history,channels:read,users:read

# Inbound email replies (POST /api/inbound/email). Off until set. Your email
# forwarder (SendGrid Inbound Parse / Mailgun / Postmark) includes this secret.
INBOUND_EMAIL_SECRET=

# B) A pasted Personal Access Token instead (no OAuth app needed).
#    GITHUB_REPO/GITHUB_TOKEN are also the headless-dev fallback used when
#    nothing is connected through the UI. Leave GITHUB_REPO empty and nothing
#    ingests — that is the correct resting state, not a bug.
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_LIMIT=30

# Where the OAuth callback sends the human back to (the web UI).
WEB_BASE_URL=http://localhost:3000

# -------------------------------------------------------------------
# Email notifications (PM + team lead get every raised situation).
# Leave SMTP_HOST empty and nothing is ever sent - the email is composed
# and printed instead. Gmail: smtp.gmail.com / 587 / an App Password.
# -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ai-os@localhost

# Where the one-click links in emails point. Must be reachable from the
# recipient's browser (localhost works if they read mail on this machine).
PUBLIC_BASE_URL=http://localhost:8000

# -------------------------------------------------------------------
# Unattended scanning. The worker syncs every connected source and runs a
# full analyse pass on this cadence, with nobody watching. On a live
# company that means real email and real GitHub writes.
# -------------------------------------------------------------------
SCAN_ENABLED=true
SCAN_INTERVAL_MINUTES=15
SCAN_INGEST_TIMEOUT=120

# -------------------------------------------------------------------
# GitHub webhook (event-driven: the AI reacts seconds after an issue
# changes, instead of at the next scan). Repo -> Settings -> Webhooks:
# payload URL <public>/api/webhooks/github, content type application/json,
# events Issues + Pull requests, secret = the value below. The endpoint
# rejects all deliveries until a secret is configured.
# -------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
